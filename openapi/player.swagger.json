  "info": {
    "description": "What the player apps call, through api-gateway-service's player profile. Send `X-Brand-Code` (the brand's code, e.g. betxyz-ke) on every request, and `Authorization: Bearer \u003ctoken\u003e` once logged in.\n\nAmounts are JSON numbers in the currency's units (940.5 is KES 940.50), with at most 4 decimals and no exponent; a numeric string (\"940.5\") is accepted too. Errors from identity are `{\"error\": \"...\"}`; from wallet, `{\"code\": \"...\", \"number\": 0, \"message\": \"...\"}`.",
    "title": "Player API",
    "version": "v1"
  },
  "paths": {
    "/v1/balance": {
      "get": {
        "operationId": "wallet.player.v1.WalletService.GetBalance",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.Balance"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/CodedError"
            }
          }
        },
        "summary": "GetBalance returns the player's balance.",
        "tags": [
          "wallet.player.v1.WalletService"
        ]
      }
    },
    "/v1/challenge": {
      "post": {
        "operationId": "identity.v1.AuthService.CreateChallenge",
        "parameters": [
          {
            "description": "The JSON body, which may name the endpoint instead.",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.CreateChallengeBody"
            }
          },
          {
            "description": "The endpoint the puzzle is for, from the query string (?endpoint=login): signup, login,\nverify, resend, forgot, reset, admin_login, admin_forgot or admin_reset. When empty, the\nbody's endpoint is used, and then signup.",
            "in": "query",
            "name": "endpoint",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/identity.v1.Challenge"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "CreateChallenge returns a proof-of-work puzzle for an endpoint. Endpoints answer 428 when\nthe caller must solve one: find a nonce such that sha256(challenge + \":\" + nonce) in hex\nstarts with difficulty zeros, then retry with X-PoW-Id (challenge_id) and X-PoW-Nonce.\nA puzzle works once, for the same user agent, until it expires.",
        "tags": [
          "identity.v1.AuthService"
        ]
      }
    },
    "/v1/config": {
      "get": {
        "operationId": "identity.v1.BrandService.GetPublicConfig",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/identity.v1.PublicConfig"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "GetPublicConfig returns the settings of the brand resolved for the request (from the\nsession, or the site's domain) that a player app needs before signup.",
        "tags": [
          "identity.v1.BrandService"
        ]
      }
    },
    "/v1/limits": {
      "get": {
        "operationId": "wallet.player.v1.WalletService.GetLimits",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.Limits"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/CodedError"
            }
          }
        },
        "summary": "GetLimits returns the daily spend limit, any raise still waiting, today's spend, what's\nleft and when the day resets.",
        "tags": [
          "wallet.player.v1.WalletService"
        ]
      },
      "put": {
        "operationId": "wallet.player.v1.WalletService.SetLimits",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.SetLimitsRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.Limits"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/CodedError"
            }
          }
        },
        "summary": "SetLimits sets the daily spend limit (0 removes it). Lowering applies at once; raising or\nremoving applies after the brand's cooling-off hours.",
        "tags": [
          "wallet.player.v1.WalletService"
        ]
      }
    },
    "/v1/login": {
      "post": {
        "operationId": "identity.v1.AuthService.Login",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.LoginRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.LoginResponse"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "Login checks a player's password and starts a session. The player is identified by\nexactly one of msisdn, email or username.",
        "tags": [
          "identity.v1.AuthService"
        ]
      }
    },
    "/v1/logout": {
      "post": {
        "operationId": "identity.v1.AuthService.Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.LogoutResponse"
            }
          },
          "default": {
            "description": "The request failed; the HTTP status says how.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "summary": "Logout ends the calling player's session. Needs a player session. 204.",
        "tags": [
          "identity.v1.AuthService"
        ]
      }
    },
    "/v1/password/forgot": {
      "patch": {
