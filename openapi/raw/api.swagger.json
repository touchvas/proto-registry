{
  "swagger": "2.0",
  "info": {
    "title": "identity/v1/identity.proto",
    "description": "identity.v1 is the internal API other domains (wallet, wagering, gaming) call.\nEvery call carries the brand (the tenant: one operator's business in one country) in the\n\"x-tenant-id\" metadata key. Responses also name the brand's operator.\n\nThis file moves to touchvasgaming/proto-registry alongside payments/core.",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "IdentityService"
    },
    {
      "name": "PlayerService"
    },
    {
      "name": "AuthService"
    },
    {
      "name": "ResponsibleGamingService"
    },
    {
      "name": "RegistryService"
    },
    {
      "name": "BrandService"
    },
    {
      "name": "WalletService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/balance": {
      "get": {
        "summary": "GetBalance returns the player's balance.",
        "operationId": "WalletService_GetBalance",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.Balance"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "tags": [
          "WalletService"
        ]
      }
    },
    "/v1/challenge": {
      "post": {
        "summary": "CreateChallenge returns a proof-of-work puzzle for an endpoint. Endpoints answer 428 when\nthe caller must solve one: find a nonce such that sha256(challenge + \":\" + nonce) in hex\nstarts with difficulty zeros, then retry with X-PoW-Id (challenge_id) and X-PoW-Nonce.\nA puzzle works once, for the same user agent, until it expires.",
        "operationId": "AuthService_CreateChallenge",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/identity.v1.Challenge"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "The JSON body, which may name the endpoint instead.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.CreateChallengeBody"
            }
          },
          {
            "name": "endpoint",
            "description": "The endpoint the puzzle is for, from the query string (?endpoint=login): signup, login,\nverify, resend, forgot, reset, admin_login, admin_forgot or admin_reset. When empty, the\nbody's endpoint is used, and then signup.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/config": {
      "get": {
        "summary": "GetPublicConfig returns the settings of the request's brand (the one the gateway\nresolved) that a player app needs before signup.",
        "operationId": "BrandService_GetPublicConfig",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/platform.v1.PublicConfig"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "tags": [
          "BrandService"
        ]
      }
    },
    "/v1/limits": {
      "get": {
        "summary": "GetLimits returns the daily spend limit, any raise still waiting, today's spend, what's\nleft and when the day resets.",
        "operationId": "WalletService_GetLimits",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.Limits"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "tags": [
          "WalletService"
        ]
      },
      "put": {
        "summary": "SetLimits sets the daily spend limit (0 removes it). Lowering applies at once; raising or\nremoving applies after the brand's cooling-off hours.",
        "operationId": "WalletService_SetLimits",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.Limits"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.SetLimitsRequest"
            }
          }
        ],
        "tags": [
          "WalletService"
        ]
      }
    },
    "/v1/login": {
      "post": {
        "summary": "Login checks a player's password and starts a session. The player is identified by\nexactly one of msisdn, email or username.",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/logout": {
      "post": {
        "summary": "Logout ends the calling player's session. Needs a player session. 204.",
        "operationId": "AuthService_Logout",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.LogoutResponse"
