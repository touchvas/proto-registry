            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "1 to 100; 20 otherwise.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "after",
            "description": "The previous page's next.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "WalletService"
        ]
      }
    },
    "/v1/verify": {
      "post": {
        "summary": "VerifyPhone confirms the signup code, activates the player and starts a session.",
