          "PlayerService"
        ]
      }
    },
    "/v1/transactions": {
      "get": {
        "summary": "ListTransactions returns the history, newest first; pass next as after for the next page.",
        "operationId": "WalletService_ListTransactions",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wallet.player.v1.ListTransactionsResponse"
