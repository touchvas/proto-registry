            }
          }
        },
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/password/forgot": {
      "patch": {
        "summary": "ForgotPassword texts a password-reset code. It answers the same whether or not the\nnumber has an account. 202.",
        "operationId": "AuthService_ForgotPassword",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.ForgotPasswordResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.ForgotPasswordRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/password/reset": {
      "patch": {
        "summary": "ResetPassword sets a new password with the texted code and ends every session.",
        "operationId": "AuthService_ResetPassword",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.ResetPasswordResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.ResetPasswordRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ]
      }
    },
    "/v1/profile": {
      "get": {
        "summary": "GetProfile returns the calling player. Needs a player session.",
        "operationId": "PlayerService_GetProfile",
        "responses": {
          "200": {
            "description": "",
            "schema": {
              "$ref": "#/definitions/identity.v1.PlayerProfile"
            }
