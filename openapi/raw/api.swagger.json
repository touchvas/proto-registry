            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "tags": [
          "PlayerService"
        ]
      }
    },
    "/v1/profile/exclusion": {
      "post": {
        "summary": "SelfExclude creates the calling player's exclusion, or extends the open one to a later\nend date. A start date of today applies at once and ends every session; a later one is\nSCHEDULED. Needs a player session. 201.",
        "operationId": "ResponsibleGamingService_SelfExclude",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/identity.v1.SelfExcludeResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/google.rpc.Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/identity.v1.SelfExcludeRequest"
            }
          }
        ],
        "tags": [
          "ResponsibleGamingService"
        ]
      }
    },
